# ─── ATS deployment configuration ───────────────────────────────
# Copy to `.env` on the VPS before `docker compose up --build`.

# Host port the container's nginx (port 80) is published on.
# nginx-proxy-manager at https://recruitment.erpoman.in forwards to
# 72.61.201.164:5174, so leave this as 5174 unless you change NPM too.
APP_PORT=5174

# ─── Initial admin (baked at BUILD time via Vite VITE_* vars) ───
# These seed the very first admin account when no admin record exists
# in the browser yet. The admin is FORCED to change the password on
# first sign-in — the initial password stops working as soon as a new
# one is set.
#
# Treat these as a one-time bootstrap secret. Once the admin has rotated
# their password, anyone who reads the bundled JS can still see this
# initial password, so it is NOT a long-term credential.
#
# Defaults if you don't set them:
#   email    = admin@ats.local
#   password = ChangeMe@1234
#   name     = Administrator
VITE_INITIAL_ADMIN_EMAIL=admin@ziontech.local
VITE_INITIAL_ADMIN_PASSWORD=ChangeMe@1234
VITE_INITIAL_ADMIN_NAME=ZIONTECH Admin

# ─── Other runtime knobs ────────────────────────────────────────
# The ATS is a fully-static client-side SPA — there is no backend.
# The following are configured *inside* the app at runtime and stored
# in the browser's localStorage:
#   - AI provider key (Anthropic or OpenAI)  → Sidebar → Settings
#   - Company profile, logo, intake webhook  → Company Settings
#   - Admin password rotation                 → Company Settings → Security
